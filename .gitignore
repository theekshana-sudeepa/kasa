# ══════════════════════════════════════════════
# KASA — Git Ignore
# ══════════════════════════════════════════════

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Environment files (keep .env.example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE / Editor
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Misc
*.pem
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Docker
docker-compose.override.yml
