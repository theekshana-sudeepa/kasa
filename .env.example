# ══════════════════════════════════════════════════════════
# KASA — Kapruka AI Shopping Agent
# Environment Variables Configuration
# ══════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# KASA works WITHOUT any API key using its smart fallback
# engine. Add a key below to unlock AI-powered conversations.
# ══════════════════════════════════════════════════════════

# ── AI Provider (choose ONE) ────────────────────────────

# Option 1: Groq — FREE, recommended for best performance
# Sign up: https://console.groq.com → API Keys
GROQ_API_KEY=

# Option 2: Google Gemini — FREE tier available
# Sign up: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Option 3: OpenAI — Paid, requires billing
# Sign up: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Kapruka MCP Server ──────────────────────────────────
# Default endpoint — no authentication required
MCP_ENDPOINT=https://mcp.kapruka.com/mcp
